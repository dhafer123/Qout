# Copy to .env and fill in real values. Never commit .env.
# All values below are dummies for local development.

# ---------- App ----------
# dev | test | staging | prod
APP_ENV=dev
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Per-dependency timeout for GET /health/ready (seconds, 0 < x <= 30)
READINESS_TIMEOUT_SECONDS=2

# ---------- PostgreSQL ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=qout
POSTGRES_PASSWORD=change-me
POSTGRES_DB=qout
POSTGRES_TEST_DB=qout_test
DATABASE_URL=postgresql+asyncpg://qout:change-me@localhost:5432/qout
TEST_DATABASE_URL=postgresql+asyncpg://qout:change-me@localhost:5432/qout_test
# Connection pool per API process
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# ---------- Redis (cache + job queue) ----------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ---------- Object storage (S3-compatible; RustFS locally) ----------
# Locally the access/secret keys are also the RustFS root credentials.
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=qout-dev-access-key
S3_SECRET_KEY=qout-dev-secret-key
S3_BUCKET=qout-uploads
S3_REGION=us-east-1

# ---------- Open Food Facts ----------
# OFF requires a descriptive User-Agent: AppName/Version (contact).
# A placeholder (example.com) is rejected at startup.
OFF_BASE_URL=https://world.openfoodfacts.org
OFF_USER_AGENT=Qout/0.1 (https://github.com/dhafer123/Qout)
# Read timeout per request (seconds); connect timeout is 3 s at most
OFF_TIMEOUT_SECONDS=10
# Retries on timeouts, connection errors, 429 and 5xx (exponential backoff)
OFF_MAX_RETRIES=3
# Requests per minute from one process (OFF's limit for product reads is 100)
OFF_RATE_LIMIT_PER_MINUTE=100

# ---------- Product lookup cache (Redis) ----------
# How long a looked-up product is served from the cache (seconds)
PRODUCT_CACHE_TTL_SECONDS=86400
# How long an unknown barcode is remembered before OFF is asked again (seconds)
PRODUCT_NOT_FOUND_TTL_SECONDS=600

# ---------- Auth ----------
JWT_SECRET=change-me-to-a-long-random-string

# ---------- Optional LLM fallback parser ----------
LLM_PARSER_ENABLED=false
LLM_API_KEY=dummy-key
