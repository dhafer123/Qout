# Copy to .env and fill in real values. Never commit .env.
# All values below are dummies for local development.

# ---------- App ----------
APP_ENV=dev
LOG_LEVEL=INFO

# ---------- PostgreSQL ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=qout
POSTGRES_PASSWORD=change-me
POSTGRES_DB=qout
POSTGRES_TEST_DB=qout_test
DATABASE_URL=postgresql+asyncpg://qout:change-me@localhost:5432/qout
TEST_DATABASE_URL=postgresql+asyncpg://qout:change-me@localhost:5432/qout_test

# ---------- Redis (cache + job queue) ----------
REDIS_URL=redis://localhost:6379/0

# ---------- Object storage (MinIO locally, S3-compatible) ----------
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minio-dummy-key
S3_SECRET_KEY=minio-dummy-secret
S3_BUCKET=qout-uploads
S3_REGION=us-east-1

# ---------- Open Food Facts ----------
# OFF requires a descriptive User-Agent: AppName/Version (contact)
OFF_BASE_URL=https://world.openfoodfacts.org
OFF_USER_AGENT=Qout/0.1 (contact@example.com)

# ---------- Auth ----------
JWT_SECRET=change-me-to-a-long-random-string

# ---------- Optional LLM fallback parser ----------
LLM_PARSER_ENABLED=false
LLM_API_KEY=dummy-key
