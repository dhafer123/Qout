# Copy to .env and fill in real values. Never commit .env.
# All values below are dummies for local development.

# ---------- App ----------
# dev | test | staging | prod
APP_ENV=dev
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Per-dependency timeout for GET /health/ready (seconds, 0 < x <= 30)
READINESS_TIMEOUT_SECONDS=2

# ---------- PostgreSQL ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=qout
POSTGRES_PASSWORD=change-me
POSTGRES_DB=qout
POSTGRES_TEST_DB=qout_test
DATABASE_URL=postgresql+asyncpg://qout:change-me@localhost:5432/qout
TEST_DATABASE_URL=postgresql+asyncpg://qout:change-me@localhost:5432/qout_test
# Connection pool per API process
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# ---------- Redis (cache + job queue) ----------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ---------- Object storage (S3-compatible; RustFS locally) ----------
# Locally the access/secret keys are also the RustFS root credentials.
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=qout-dev-access-key
S3_SECRET_KEY=qout-dev-secret-key
S3_BUCKET=qout-uploads
S3_REGION=us-east-1

# ---------- Open Food Facts ----------
# OFF requires a descriptive User-Agent: AppName/Version (contact).
# A placeholder (example.com) is rejected at startup.
OFF_BASE_URL=https://world.openfoodfacts.org
OFF_USER_AGENT=Qout/0.1 (https://github.com/dhafer123/Qout)
# Read timeout per request (seconds); connect timeout is 3 s at most
OFF_TIMEOUT_SECONDS=10
# Retries on timeouts, connection errors, 429 and 5xx (exponential backoff)
OFF_MAX_RETRIES=3
# Requests per minute from one process (OFF's limit for product reads is 100)
OFF_RATE_LIMIT_PER_MINUTE=100

# ---------- Product lookup cache (Redis) ----------
# How long a looked-up product is served from the cache (seconds)
PRODUCT_CACHE_TTL_SECONDS=86400
# How long an unknown barcode is remembered before OFF is asked again (seconds)
PRODUCT_NOT_FOUND_TTL_SECONDS=600

# ---------- Bulk import from Open Food Facts (worker) ----------
# OFF country tags, comma-separated (products sold in any of them are imported)
IMPORT_COUNTRIES=en:tunisia
# Products stored per transaction (each commit also saves the resume checkpoint)
IMPORT_BATCH_SIZE=500
# Where export and delta files are downloaded (the full export is ~14 GB; deleted after import)
IMPORT_DOWNLOAD_DIR=var/imports
OFF_EXPORT_URL=https://static.openfoodfacts.org/data/openfoodfacts-products.jsonl.gz
# Folder with index.txt and the daily delta files
OFF_DELTA_URL=https://static.openfoodfacts.org/data/delta/
# Daily delta import (arq cron), hour in UTC
IMPORT_DELTA_CRON_ENABLED=true
IMPORT_DELTA_CRON_HOUR=4

# ---------- Auth (contributor accounts; scanning needs none) ----------
# HS256 key for access tokens, at least 32 characters. Dev and test fall back to a built-in
# dev key; staging and prod refuse it and anything starting with "change-me".
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
# Access token lifetime (seconds, 60-3600) and refresh token lifetime (days, 1-365)
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Login rate limits per window: failed logins per email, attempts per IP
LOGIN_MAX_FAILURES_PER_EMAIL=5
LOGIN_MAX_ATTEMPTS_PER_IP=20
LOGIN_WINDOW_SECONDS=900
# Registrations per IP per window
REGISTER_MAX_PER_IP=5
REGISTER_WINDOW_SECONDS=3600

# ---------- Optional LLM fallback parser ----------
LLM_PARSER_ENABLED=false
LLM_API_KEY=dummy-key
