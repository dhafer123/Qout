# Copy to .env and fill in real values. Never commit .env.
# All values below are dummies for local development.

# ---------- App ----------
# dev | test | staging | prod
APP_ENV=dev
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Per-dependency timeout for GET /health/ready (seconds, 0 < x <= 30)
READINESS_TIMEOUT_SECONDS=2

# ---------- PostgreSQL ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=qout
POSTGRES_PASSWORD=change-me
POSTGRES_DB=qout
POSTGRES_TEST_DB=qout_test
DATABASE_URL=postgresql+asyncpg://qout:change-me@localhost:5432/qout
TEST_DATABASE_URL=postgresql+asyncpg://qout:change-me@localhost:5432/qout_test
# Connection pool per API process
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# ---------- Redis (cache + job queue) ----------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ---------- Object storage (S3-compatible; RustFS locally) ----------
# Locally the access/secret keys are also the RustFS root credentials.
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=qout-dev-access-key
S3_SECRET_KEY=qout-dev-secret-key
S3_REGION=us-east-1
# Private bucket: contribution photos (uploaded by the app with presigned URLs)
S3_BUCKET=qout-uploads
# Public-read bucket: product photos shown in the app (must differ from S3_BUCKET)
S3_PUBLIC_BUCKET=qout-public
# Where the public bucket's objects are served from (the bucket itself, or a CDN)
MEDIA_BASE_URL=http://localhost:9000/qout-public/
# Host written into presigned upload URLs, which the phone calls directly. Leave empty to
# use S3_ENDPOINT_URL; on a real phone use an address it can reach (e.g. http://192.168.1.20:9000).
S3_PUBLIC_ENDPOINT_URL=
# Staging and prod refuse the dev access/secret keys above.

# ---------- Contribution photo uploads ----------
# Largest accepted photo (bytes) and how long an upload URL stays valid (seconds)
UPLOAD_MAX_BYTES=8388608
UPLOAD_URL_TTL_SECONDS=300
# Upload URLs one user may request per window
UPLOAD_MAX_PER_USER=30
UPLOAD_WINDOW_SECONDS=3600

# ---------- Open Food Facts ----------
# OFF requires a descriptive User-Agent: AppName/Version (contact).
# A placeholder (example.com) is rejected at startup.
OFF_BASE_URL=https://world.openfoodfacts.org
OFF_USER_AGENT=Qout/0.1 (https://github.com/dhafer123/Qout)
# Read timeout per request (seconds); connect timeout is 3 s at most
OFF_TIMEOUT_SECONDS=10
# Retries on timeouts, connection errors, 429 and 5xx (exponential backoff)
OFF_MAX_RETRIES=3
# Requests per minute from one process (OFF's limit for product reads is 100)
OFF_RATE_LIMIT_PER_MINUTE=100

# ---------- Product lookup cache (Redis) ----------
# How long a looked-up product is served from the cache (seconds)
PRODUCT_CACHE_TTL_SECONDS=86400
# How long an unknown barcode is remembered before OFF is asked again (seconds)
PRODUCT_NOT_FOUND_TTL_SECONDS=600

# ---------- Bulk import from Open Food Facts (worker) ----------
# OFF country tags, comma-separated (products sold in any of them are imported)
IMPORT_COUNTRIES=en:tunisia
# Products stored per transaction (each commit also saves the resume checkpoint)
IMPORT_BATCH_SIZE=500
# Where export and delta files are downloaded (the full export is ~14 GB; deleted after import)
IMPORT_DOWNLOAD_DIR=var/imports
OFF_EXPORT_URL=https://static.openfoodfacts.org/data/openfoodfacts-products.jsonl.gz
# Folder with index.txt and the daily delta files
OFF_DELTA_URL=https://static.openfoodfacts.org/data/delta/
# Daily delta import (arq cron), hour in UTC
IMPORT_DELTA_CRON_ENABLED=true
IMPORT_DELTA_CRON_HOUR=4

# ---------- Error reports ("Report an error"; no account needed) ----------
# New reports from one IP per window
REPORT_MAX_PER_IP=20
REPORT_WINDOW_SECONDS=3600

# ---------- Product photos (worker copies OFF front photos into S3_PUBLIC_BUCKET) ----------
# Larger photos are skipped (bytes)
PRODUCT_IMAGE_MAX_BYTES=2097152
# Copy new and changed photos every 15 minutes (arq cron)
PRODUCT_IMAGES_CRON_ENABLED=true

# ---------- Daily cleanup (worker): what contributions leave behind ----------
# Run every day at this hour (UTC, 0-23; arq cron)
CLEANUP_CRON_ENABLED=true
CLEANUP_CRON_HOUR=3
# Days kept: uploaded photos no contribution refers to (after the upload), photos of
# rejected contributions (after the rejection), LLM fallback requests with their OCR text
UNSUBMITTED_UPLOAD_RETENTION_DAYS=7
REJECTED_PHOTO_RETENTION_DAYS=30
LABEL_FALLBACK_RETENTION_DAYS=7

# ---------- Auth (contributor accounts; scanning needs none) ----------
# HS256 key for access tokens, at least 32 characters. Dev and test fall back to a built-in
# dev key; staging and prod refuse it and anything starting with "change-me".
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
# Access token lifetime (seconds, 60-3600) and refresh token lifetime (days, 1-365)
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Login rate limits per window: failed logins per email, attempts per IP
LOGIN_MAX_FAILURES_PER_EMAIL=5
LOGIN_MAX_ATTEMPTS_PER_IP=20
LOGIN_WINDOW_SECONDS=900
# Registrations per IP per window
REGISTER_MAX_PER_IP=5
REGISTER_WINDOW_SECONDS=3600

# ---------- Admin panel (/admin, moderators only) ----------
# Signs the panel's session cookie: at least 32 characters, not the same as JWT_SECRET.
# Dev and test fall back to a built-in dev key; staging and prod refuse it and "change-me...".
ADMIN_SESSION_SECRET=change-me-to-another-long-random-string
# A panel session ends this long after signing in (seconds, 300-604800)
ADMIN_SESSION_TTL_SECONDS=28800
# How long the links to a contribution's private photos work (seconds, 30-3600)
ADMIN_PHOTO_URL_TTL_SECONDS=300

# ---------- Optional LLM fallback parser (labels the rule-based parser can't read) ----------
# Google Gemini API (key from https://aistudio.google.com/apikey). Only the label's OCR text
# is sent. Enabling it needs a real API key.
LLM_PARSER_ENABLED=false
LLM_API_KEY=dummy-key
# Gemini model id
LLM_MODEL=gemini-3.8-flash
# One reading, SDK retries included (seconds)
LLM_TIMEOUT_SECONDS=30
# A reading not finished this long after it was asked for (queue wait included) is given up:
# the contributor types the values (seconds, must exceed LLM_TIMEOUT_SECONDS)
LLM_PARSE_DEADLINE_SECONDS=90
# LLM readings one user may ask for per window; beyond, manual entry
LLM_PARSE_MAX_PER_USER=20
LLM_PARSE_WINDOW_SECONDS=3600
